# Plantilla para la VM de Azure: cópiala como .env y completa los valores (el .env no se sube a git)

# Dirección pública (nombre DNS de la VM), sin https://
DOMINIO=tuapp.region.cloudapp.azure.com

# Imágenes que publica el CI
REGISTRY=ghcr.io/paololozano/sistema-satelite
TAG=latest

# Contraseñas propias (usa valores largos y distintos entre sí)
POSTGRES_PASSWORD=
DB_PASS=
RABBIT_USER=satelite
RABBIT_PASS=

# Clave de firma de los tokens: openssl rand -base64 48
JWT_SECRET=

# Telegram (opcional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
