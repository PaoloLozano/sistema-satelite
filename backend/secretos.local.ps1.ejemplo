# Copia este archivo como secretos.local.ps1 y escribe tus valores. NO lo subas a Git ni lo compartas.
# El token se obtiene con @BotFather en Telegram; el Chat ID con https://api.telegram.org/bot<TOKEN>/getUpdates
# Si no se define, el sistema funciona igual pero no envía alertas a Telegram.
$env:TELEGRAM_TOKEN   = 'PEGA_AQUI_EL_TOKEN_DE_TU_BOT'
$env:TELEGRAM_CHAT_ID = 'PEGA_AQUI_TU_CHAT_ID'
